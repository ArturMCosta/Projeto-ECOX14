
# Dados: ficam apenas na sua maquina, nunca no GitHub.
# O codigo do projeto reconstroi estes arquivos.
dados/bronze/*
dados/prata/*
dados/ouro/*
relatorios/

# Excecao: mantem as pastas visiveis no GitHub, mesmo vazias.
!dados/**/.gitkeep

# Arquivos gerados pelo Python
__pycache__/
*.pyc

# Ambiente virtual
.venv/
venv/

# Configuracoes do editor
.vscode/
.idea/

# Credenciais: nunca versione senhas ou chaves de acesso
.env
kaggle.json

# Apresentacoes: arquivos gerados, nao versionados
apresentacao.pdf
apresentacao.pptx

# Registro de execucao: gerado pelo pipeline
pipeline.log

# dbt: artefatos de execucao, gerados a cada run
ecox14/target/
ecox14/logs/
ecox14/dbt_packages/
